        Technologies =
        [
            "C#",
            "ASP.NET Core",
            "ML.NET",
            "SQL"
        ],

        GithubUrl = "https://github.com/"
    },

    new Project
    {
        Name = "ASP.NET Core API",

        Description =
            "API REST desarrollada para practicar HTTP, controladores, servicios y acceso a datos.",

        Technologies =
        [
            "C#",
            "ASP.NET Core",
